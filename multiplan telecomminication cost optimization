budget = int(input("Enter your budget: "))
usage = int(input("Enter required data in GB: "))

plans = [
    ["Plan A", 199, 2],
    ["Plan B", 299, 5],
    ["Plan C", 399, 10]
]

best_plan = None
lowest_cost = 99999

for plan in plans:
    name, price, data = plan
    extra = max(0, usage - data) * 20
    total = price + extra

    print(name, "Total Cost:", total)

    if total <= budget and total < lowest_cost:
        lowest_cost = total
        best_plan = name

if best_plan:
    print("Best Plan:", best_plan)
    print("Total Cost:", lowest_cost)
else:
    print("No suitable plan")